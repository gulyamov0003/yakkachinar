{
  "name": "yakkachinar",
  "private": true,
  "version": "0.1.0",
  "description": "Yakkachinar — luxury restaurant & entertainment venue website concept (Dushanbe, Tajikistan)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n:check && tsc --noEmit && vite build",
